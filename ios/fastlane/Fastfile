# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#

default_platform(:ios)

platform :ios do
  # App Store Connect API Key
  def api_key
    # Read from environment variables
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY"],
      is_key_content_base64: false
    )
  end

  desc "Push a new beta build to TestFlight"
  lane :beta do
    # Sync code signing with Match
    match_options = {
      type: "appstore",
      readonly: is_ci,
      app_identifier: ["com.abish.reppy", "com.abish.reppy.widget"]
    }

    # Add keychain configuration for CI environment
    if is_ci && ENV["KEYCHAIN_NAME"] && ENV["KEYCHAIN_PASSWORD"]
      match_options[:keychain_name] = ENV["KEYCHAIN_NAME"]
      match_options[:keychain_password] = ENV["KEYCHAIN_PASSWORD"]
    end

    # Temporarily unset API key env vars for Match (it doesn't need them)
    # Store the values to restore later
    api_key_id = ENV.delete("APP_STORE_CONNECT_API_KEY_ID")
    api_issuer_id = ENV.delete("APP_STORE_CONNECT_API_ISSUER_ID")
    api_key_content = ENV.delete("APP_STORE_CONNECT_API_KEY")

    match(match_options)

    # Restore API key env vars for upload_to_testflight
    ENV["APP_STORE_CONNECT_API_KEY_ID"] = api_key_id if api_key_id
    ENV["APP_STORE_CONNECT_API_ISSUER_ID"] = api_issuer_id if api_issuer_id
    ENV["APP_STORE_CONNECT_API_KEY"] = api_key_content if api_key_content

    # Increment build number
    increment_build_number(
      xcodeproj: "Reppy.xcodeproj"
    )

    # Update code signing settings to use Match profiles
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Reppy.xcodeproj",
      profile_name: "match AppStore com.abish.reppy",
      code_sign_identity: "Apple Distribution",
      targets: ["Reppy"]
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Reppy.xcodeproj",
      profile_name: "match AppStore com.abish.reppy.widget",
      code_sign_identity: "Apple Distribution",
      targets: ["ReppyWidgetExtension"]
    )

    # Build the app
    build_app(
      scheme: "Reppy",
      export_method: "app-store",
      codesigning_identity: "Apple Distribution",
      export_options: {
        uploadBitcode: false,
        uploadSymbols: false,
        compileBitcode: false,
        manageAppVersionAndBuildNumber: false,
        provisioningProfiles: {
          "com.abish.reppy" => "match AppStore com.abish.reppy",
          "com.abish.reppy.widget" => "match AppStore com.abish.reppy.widget"
        }
      }
    )

    # Upload to TestFlight
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: false,
      notify_external_testers: false
    )

    # Success message
    puts "✅ Build uploaded to TestFlight successfully!"
    puts "Check App Store Connect in 5-10 minutes for processing status"
  end

  desc "Build and archive only (no upload)"
  lane :build_only do
    increment_build_number(
      xcodeproj: "Reppy.xcodeproj"
    )

    build_app(
      scheme: "Reppy",
      export_method: "app-store",
      skip_package_ipa: false,
      xcargs: "-allowProvisioningUpdates",
      export_options: {
        uploadBitcode: false,
        uploadSymbols: false,
        compileBitcode: false,
        signingStyle: "automatic",
        signingCertificate: "Apple Distribution",
        teamID: "9M9375N2XL"
      }
    )

    puts "✅ Build completed! IPA location: #{lane_context[SharedValues::IPA_OUTPUT_PATH]}"
  end

  desc "Upload existing IPA to TestFlight"
  lane :upload_only do |options|
    ipa_path = options[:ipa] || ENV["IPA_PATH"]

    if ipa_path.nil?
      UI.user_error!("Please provide an IPA path: fastlane upload_only ipa:/path/to/app.ipa")
    end

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )

    puts "✅ IPA uploaded to TestFlight successfully!"
  end
end
